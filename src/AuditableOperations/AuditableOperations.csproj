<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>AuditableOperations</RootNamespace>
    <AssemblyName>AuditableOperations</AssemblyName>
    <PackageId>erick9125.AuditableOperations</PackageId>
    <Version>0.1.0</Version>
    <Description>Structured audit trails for ASP.NET Core and EF Core with entity change tracking, request context and sensitive data redaction.</Description>
    <PackageTags>aspnetcore;efcore;audit;logging;observability;security</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Deliberately a package reference and not FrameworkReference to Microsoft.AspNetCore.App:
      the HTTP context accessor is one optional file, and requiring the ASP.NET Core shared
      framework would force every consumer - workers, console hosts, daemons - to be a web app.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
